# DevAssistant - Variables de entorno
# Copia este archivo como .env y agrega tus API keys reales
# NUNCA commitees el archivo .env

# ========== ANTHROPIC ==========
# Modelo de Anthropic a usar (opciones: claude-haiku-5-5, claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5

# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== OPENAI ==========
# Modelo de OpenAI a usar (opciones: gpt-6-luna, gpt-6-sol)
OPENAI_MODEL=gpt-6-luna

# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== MOONSHOT ==========
MOONSHOT_MODEL=kimi-k

# https://platform.kimi.ai/console/projects/api-keys
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== DEEPSEEK ==========
DEEPSEEK_MODEL=deepseek-flash

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === RAG ===
# Directorio donde está la documentación a indexar
DOCS_PATH=./docs/sample-project

# Ruta a la base de datos de vectores
DB_PATH=./data/vectors.db

# Número de chunks a recuperar por búsqueda
RAG_TOP_K=5

# ======= EMBEDDING MODELS ========
#OPENAI
# Modelo de embeddings de OpenAI (text-embedding-3-small o text-embedding-3-large)
# https://developers.openai.com/api/docs/guides/embeddings
# usa la misma api de openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# VOYAGE AI
# https://platform.claude.com/docs/en/build-with-claude/embeddings
# https://blog.voyageai.com/2026/01/15/voyage-4/
VOYAGE_AI_EMBEDDING_MODEL=voyage-4-lite

# https://dashboard.voyageai.com/api-keys
VOYAGE_AI_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx